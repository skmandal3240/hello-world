generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  passwordHash       String
  displayName        String
  avatarUrl          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  nativeLanguageId   String?
  learningLanguageId String?
  proficiencyLevel   ProficiencyLevel @default(A1)
  onboardingComplete Boolean          @default(false)

  refreshTokens      RefreshToken[]
  nativeLanguage     Language?        @relation("NativeLanguage", fields: [nativeLanguageId], references: [id])
  learningLanguage   Language?        @relation("LearningLanguage", fields: [learningLanguageId], references: [id])
  sessionsAsUserA    Session[]        @relation("UserA")
  sessionsAsUserB    Session[]        @relation("UserB")

  totalSessions      Int              @default(0)
  currentStreak      Int              @default(0)
  longestStreak      Int              @default(0)
  lastSessionDate    DateTime?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@map("refresh_tokens")
}

model Language {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  nativeName String
  flagEmoji  String?

  nativeSpeakers     User[]    @relation("NativeLanguage")
  learners           User[]    @relation("LearningLanguage")
  sessionsTargetLang Session[] @relation("TargetLanguage")
  sessionsSourceLang Session[] @relation("SourceLanguage")

  @@map("languages")
}

model Session {
  id               String        @id @default(cuid())
  userAId          String
  userBId          String?
  targetLanguageId String
  sourceLanguageId String
  status           SessionStatus @default(WAITING)
  startedAt        DateTime?
  endedAt          DateTime?
  durationSeconds  Int?
  createdAt        DateTime      @default(now())

  userA            User          @relation("UserA", fields: [userAId], references: [id])
  userB            User?         @relation("UserB", fields: [userBId], references: [id])
  targetLanguage   Language      @relation("TargetLanguage", fields: [targetLanguageId], references: [id])
  sourceLanguage   Language      @relation("SourceLanguage", fields: [sourceLanguageId], references: [id])
  utterances       Utterance[]
  feedbackEntries  FeedbackEntry[]

  @@map("sessions")
}

model Utterance {
  id             String        @id @default(cuid())
  sessionId      String
  speakerId      String
  transcript     String
  languageCode   String
  sequenceNumber Int
  spokenAt       DateTime      @default(now())

  session        Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedbackEntry  FeedbackEntry?

  @@map("utterances")
}

model FeedbackEntry {
  id                    String   @id @default(cuid())
  sessionId             String
  utteranceId           String   @unique
  userId                String

  correctedText         String?
  grammarErrors         Json
  vocabularySuggestions Json
  pronunciationScore    Int?
  overallFeedback       String?
  rawAiResponse         String

  createdAt             DateTime @default(now())

  session               Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  utterance             Utterance @relation(fields: [utteranceId], references: [id], onDelete: Cascade)

  @@map("feedback_entries")
}

enum ProficiencyLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SessionStatus {
  WAITING
  MATCHED
  ACTIVE
  ENDED
  ABANDONED
}
